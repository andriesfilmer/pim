<%= render "layouts/show_errors", resource: resource %>
<div class="row">
  <div class="columns">
    <h2>Settings</h2>
    <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
      <div class="columns callout warning">Currently waiting confirmation for: <%= resource.unconfirmed_email %></div>
    <% end %>
  </div>
</div>

<div class="row">
  <fieldset class="col-12">
    <legend class="strong">Name and password</legend>
    <%= form_for(resource, as: resource_name, url: registration_path(resource_name),
        data: { turbo: false }, html: { method: :put }) do |f| %>

    <div class="row">
      <div class="columns">
        <%= f.label :name %>
        <%= f.text_field :name, autofocus: true, autocomplete: "name" %>
      </div>

      <div class="columns">
        <%= f.label :email %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email" %>
      </div>

      <div class="columns">
        <%= f.label :password, class: "display-inline" %>
        <%= content_tag :em,"(#{@minimum_password_length} characters minimum)", class: "meta-data" if @minimum_password_length %>
        <i class="meta-data">Leave blank if you don't want to change it</i>
        <%= f.password_field :password, autocomplete: "new-password" %>
      </div>

      <div class="columns">
        <%= f.label :password_confirmation %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password" %>
      </div>

      <div class="columns">
        <%= f.label :current_password, class: "display-inline" %> <i class="meta-data">(we need your current password to confirm your password change)</i>
        <%= f.password_field :current_password, autocomplete: "off" %>
      </div>

      <div class="columns">
        <%= f.submit "Update", class: "button" %>
      </div>
    </div>
    <% end %>
  </fieldset>
</div>

<div class="row mt-4" data-controller="user">
  <fieldset class="col-12">
    <legend class="strong">Offline data</legend>
    <div class="row p-4">
      <div class="columns medium-6">
        <p>Enable to access your events, contacts, posts and passwords* when offline. Data is stored <strong>unencrypted</strong> locally and cleared on logout.</p>
        <i><super>*</super>Only password set as 'Available offline' are available offline.</i>
      </div>
      <div class="columns medium-6 p-4">
        <label>Offline data</label>
        <%= label_tag "offline_data", class: "switch" do %>
          <%= check_box_tag "offline_data", "true", current_user.offline_data, data: { action: "click->user#setOfflineData" }, class: "switch" %>
          <span class="slider round"></span>
        <% end %>
      </div>
    </div>
  </fieldset>
</div>

<div class="row mt-4">
  <fieldset class="col-12">
    <legend class="strong">Backup data</legend>
    <%= form_with url: backup_path, method: :get, data: { turbo: false } do %>
      <div class="row p-4">
        <div class="columns medium-6">
          <div>Download a backup of your data as an Excel (.xlsx) file, with one sheet per selected resource. Passwords are exported <strong>unencrypted</strong>.</div>
          <p class="display-inline">
          <label class="p-4"><%= check_box_tag "resources[]", "calendar", true, class: "display-block" %> Calendar</label>
          <label class="p-4"><%= check_box_tag "resources[]", "contacts", true, class: "display-block" %> Contacts</label>
          <label class="p-4"><%= check_box_tag "resources[]", "posts", true, class: "display-block" %> Posts</label>
          <label class="p-4"><%= check_box_tag "resources[]", "passwords", true, class: "display-block" %> Passwords</label>
          </p>
        </div>
        <div class="columns medium-6 p-4">
          <%= submit_tag "Download XLSX", class: "button" %>
        </div>
      </div>
    <% end %>
  </fieldset>
</div>

<div class="row mt-4">
  <fieldset class="col-12">
    <legend class="strong">Delete my account</legend>
    <div class="row p-4">
      <div class="columns">
        <%= button_to "Delete", registration_path(resource_name), data: { confirm: "Are you sure?",
          turbo_confirm: "Are you sure?" }, method: :delete, class: "button alert" %>
      </div>
    </div>
  </fieldset>
</div>
